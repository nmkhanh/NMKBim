<Window x:Class="NMKBim.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:NMKBim.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource Str_AppTitle}"
        Height="840" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBaseBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <!-- Top App Bar -->
            <RowDefinition Height="*"/>
            <!-- Main Content Area -->
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo + Select File Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="6,4" Margin="0,0,10,0">
                        <TextBlock Text="NMK" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Str_AppTitle}" Foreground="{DynamicResource TextMainBrush}" 
                               FontWeight="Bold" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <!-- BUTTON SELECT FILE (MULTI-FILE) -->
                    <Button Style="{StaticResource PrimaryAccentButtonStyle}" 
                            Content="{DynamicResource Str_OpenFile}"
                            Command="{Binding OpenFileDialogCommand}"
                            Padding="12,6"/>
                </StackPanel>

                <!-- Top Center: Multi-Viewport Layout Mode Switcher (1, 2, 3, 4) & View Modes & Graphic Mode -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Layout Mode Selector -->
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Layout:" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" 
                                       VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <Button Style="{StaticResource ModernButtonStyle}" Content="1 View"
                                    Command="{Binding SetLayoutModeCommand}" CommandParameter="1" Margin="2,0"/>
                            <Button Style="{StaticResource ModernButtonStyle}" Content="2 (Split)"
                                    Command="{Binding SetLayoutModeCommand}" CommandParameter="2" Margin="2,0"/>
                            <Button Style="{StaticResource ModernButtonStyle}" Content="3 Views"
                                    Command="{Binding SetLayoutModeCommand}" CommandParameter="3" Margin="2,0"/>
                            <Button Style="{StaticResource ModernButtonStyle}" Content="4 (Quad)"
                                    Command="{Binding SetLayoutModeCommand}" CommandParameter="4" Margin="2,0"/>
                        </StackPanel>
                    </Border>

                    <!-- View Orientation Modes -->
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="6" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ModernButtonStyle}" Content="{DynamicResource Str_View3D}"
                                    Command="{Binding SetViewModeCommand}" CommandParameter="3D" Margin="2,0"/>
                            <Button Style="{StaticResource ModernButtonStyle}" Content="{DynamicResource Str_ViewTop}"
                                    Command="{Binding SetViewModeCommand}" CommandParameter="Top" Margin="2,0"/>
                            <ComboBox SelectedValue="{Binding PlanDirection, Mode=TwoWay}" SelectedValuePath="Tag"
                                      Width="76" Height="26" FontSize="14" Margin="2,0"
                                      Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextMainBrush}"
                                      ToolTip="Plan View Direction">
                                <ComboBoxItem Content="Top" Tag="top"/>
                                <ComboBoxItem Content="Bottom" Tag="bottom"/>
                            </ComboBox>
                            <Button Style="{StaticResource ModernButtonStyle}" Content="{DynamicResource Str_ViewSection}"
                                    Command="{Binding SetViewModeCommand}" CommandParameter="Section" Margin="2,0"/>
                            <ComboBox SelectedValue="{Binding SectionDirection, Mode=TwoWay}" SelectedValuePath="Tag"
                                      Width="76" Height="26" FontSize="14" Margin="2,0"
                                      Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextMainBrush}"
                                      ToolTip="Section Cut Direction">
                                <ComboBoxItem Content="Front" Tag="front"/>
                                <ComboBoxItem Content="Back" Tag="back"/>
                                <ComboBoxItem Content="Left" Tag="left"/>
                                <ComboBoxItem Content="Right" Tag="right"/>
                            </ComboBox>
                            <CheckBox IsChecked="{Binding SectionHasDepth, Mode=TwoWay}"
                                      Content="Depth" Foreground="{DynamicResource TextMutedBrush}"
                                      VerticalAlignment="Center" Margin="4,0,2,0" FontSize="14"
                                      ToolTip="View depth: Box volume vs instant 2D plane cut"/>
                        </StackPanel>
                    </Border>

                    <!-- Graphic Render Mode (Shaded / Wireframe) -->
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="3" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mode:" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" 
                                       VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <Button Style="{StaticResource ModernButtonStyle}" Content="{Binding GraphicMode}"
                                    Command="{Binding ToggleGraphicModeCommand}" ToolTip="Toggle Graphic Mode (Shaded / Wireframe)" Margin="2,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Right: Language, Theme & Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="95" Margin="0,0,6,0" SelectedValuePath="Tag" SelectedValue="{Binding CurrentLanguage}">
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Deutsch" Tag="de"/>
                        <ComboBoxItem Content="日本語" Tag="ja"/>
                    </ComboBox>

                    <Button Style="{StaticResource ModernButtonStyle}" Content="{Binding CurrentTheme}"
                            Command="{Binding ToggleThemeCommand}" ToolTip="Toggle Dark/Light Theme" Margin="0,0,6,0"/>

                    <Button Style="{StaticResource ModernButtonStyle}" Content="⚙ Settings"
                            Command="{Binding ToggleSettingsCommand}" ToolTip="Settings Dialog"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <!-- Left Sidebar: Loaded Files with Checkbox & Remove -->
                <ColumnDefinition Width="*"/>
                <!-- Viewports & Schedule Area -->
                <ColumnDefinition Width="340"/>
                <!-- Right Sidebar: Properties & Color Override -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: LISTBOX LOADED FILES -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" Padding="12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="{DynamicResource Str_LoadedFilesTitle}" Foreground="{DynamicResource TextMainBrush}"
                                       FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Content="Clear All"
                                    Command="{Binding ClearAllFilesCommand}"
                                    Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="14" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- ListBox containing loaded files with checkbox & remove button -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding LoadedFiles}"
                             Background="Transparent" BorderThickness="0" Margin="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextMainBrush}" 
                                                       FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding ObjectCount, StringFormat='{}Elements: {0}'}" 
                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <!-- Color selector with Reset option -->
                                                <ComboBox SelectedValue="{Binding ColorHex, Mode=TwoWay}" SelectedValuePath="Tag"
                                                           Width="84" Height="24" FontSize="14" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextMainBrush}">
                                                    <ComboBoxItem Tag="{x:Null}" Content="Reset (Orig)"/>
                                                    <ComboBoxItem Tag="#94A3B8" Content="Default"/>
                                                    <ComboBoxItem Tag="#3B82F6" Content="Blue"/>
                                                    <ComboBoxItem Tag="#EF4444" Content="Red"/>
                                                    <ComboBoxItem Tag="#10B981" Content="Green"/>
                                                    <ComboBoxItem Tag="#F59E0B" Content="Orange"/>
                                                    <ComboBoxItem Tag="#8B5CF6" Content="Purple"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <!-- Opacity Slider -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Opacity:" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding Opacity, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Nút Xóa File -->
                                        <Button Grid.Column="2" Content="✕" 
                                                Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Cursor="Hand" Padding="4" ToolTip="Remove File" FontSize="14"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- CENTER: MULTI-VIEWPORT & SCHEDULE AREA -->
            <Grid Grid.Column="1" Background="{DynamicResource ViewportBgBrush}">
                <!-- Layout 1: Single 3D Viewport -->
                <Grid Visibility="{Binding LayoutMode, ConverterParameter=1, Converter={StaticResource StringEqualsToVisibilityConverter}, FallbackValue=Visible}">
                    <helix:HelixViewport3D x:Name="viewPort"
                                           ShowCoordinateSystem="True"
                                           ShowViewCube="True"
                                           ViewCubeWidth="55"
                                           ViewCubeBackText="BACK"
                                           ViewCubeFrontText="FRONT"
                                           ViewCubeTopText="TOP"
                                           ViewCubeBottomText="BOTTOM"
                                           ViewCubeLeftText="LEFT"
                                           ViewCubeRightText="RIGHT"
                                           IsViewCubeEdgeClicksEnabled="True"
                                           ShowTriangleCountInfo="True"
                                           ShowFrameRate="True"
                                           IsMoveEnabled="True"
                                           IsRotationEnabled="True"
                                           IsZoomEnabled="True"
                                           ZoomAroundMouseDownPoint="True"
                                           ZoomExtentsWhenLoaded="True">
                        <helix:HelixViewport3D.ContextMenu>
                            <ContextMenu Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                <MenuItem Header="{DynamicResource Str_MenuIsolate}" 
                                          Command="{Binding IsolateSelectedCommand}"
                                          Foreground="{DynamicResource TextMainBrush}"/>
                                <MenuItem Header="{DynamicResource Str_MenuHide}" 
                                          Command="{Binding HideSelectedCommand}"
                                          Foreground="{DynamicResource TextMainBrush}"/>
                                <Separator Background="{DynamicResource BorderBrush}"/>
                                <MenuItem Header="Create Section from Element" 
                                          Command="{Binding CreateSectionFromSelectedCommand}"
                                          Foreground="{DynamicResource TextMainBrush}"/>
                                <Separator Background="{DynamicResource BorderBrush}"/>
                                <MenuItem Header="{DynamicResource Str_MenuReset}" 
                                          Command="{Binding ResetVisibilityCommand}"
                                          Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                            </ContextMenu>
                        </helix:HelixViewport3D.ContextMenu>
                        <helix:DefaultLights/>
                        <ModelVisual3D Content="{Binding RealScene3DGroup}"/>
                    </helix:HelixViewport3D>
                </Grid>

                <!-- Layout 2: Split 2 (3D View + Schedule DataGrid) -->
                <Grid Visibility="{Binding LayoutMode, ConverterParameter=2, Converter={StaticResource StringEqualsToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <helix:HelixViewport3D Grid.Column="0" ShowCoordinateSystem="True" ShowViewCube="True" ViewCubeWidth="90">
                        <helix:DefaultLights/>
                        <ModelVisual3D Content="{Binding RealScene3DGroup}"/>
                    </helix:HelixViewport3D>

                    <!-- Schedule Table Viewport -->
                    <Border Grid.Column="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="Schedule &amp; Quantities" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" FontSize="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FilteredScheduleObjects.Count, StringFormat='{}{0} Elements'}" 
                                               Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Schedule Search & Quick Select Filter -->
                            <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ScheduleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="26" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextMainBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" VerticalContentAlignment="Center" Padding="4,0" FontSize="14"
                                             ToolTip="Search by ID, category, or material"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Style="{StaticResource ModernButtonStyle}" Content="Select All"
                                                Command="{Binding SelectAllFilteredCommand}" Padding="6,2" FontSize="14" Margin="2,0"/>
                                        <Button Style="{StaticResource ModernButtonStyle}" Content="Clear"
                                                Command="{Binding DeselectAllFilteredCommand}" Padding="6,2" FontSize="14" Margin="2,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredScheduleObjects}"
                                      SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                                      SelectionMode="Extended"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      EnableRowVirtualization="True"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Style="{StaticResource ModernDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                                    <DataGridTextColumn Header="Material" Binding="{Binding MaterialId}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Layout 4: Quad 4 Views (3D, Top Plan, Section, Schedule DataGrid) -->
                <Grid Visibility="{Binding LayoutMode, ConverterParameter=4, Converter={StaticResource StringEqualsToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- View 1: 3D Perspective -->
                    <helix:HelixViewport3D Grid.Row="0" Grid.Column="0" ShowCoordinateSystem="True" ShowViewCube="True" ViewCubeWidth="55">
                        <helix:DefaultLights/>
                        <ModelVisual3D Content="{Binding RealScene3DGroup}"/>
                    </helix:HelixViewport3D>

                    <!-- View 2: Top Plan -->
                    <helix:HelixViewport3D Grid.Row="0" Grid.Column="1" ShowCoordinateSystem="True" ShowViewCube="False" Orthographic="True">
                        <helix:DefaultLights/>
                        <ModelVisual3D Content="{Binding RealScene3DGroup}"/>
                    </helix:HelixViewport3D>

                    <!-- View 3: Section Cut -->
                    <helix:HelixViewport3D Grid.Row="1" Grid.Column="0" ShowCoordinateSystem="True" ShowViewCube="False">
                        <helix:DefaultLights/>
                        <ModelVisual3D Content="{Binding RealScene3DGroup}"/>
                    </helix:HelixViewport3D>

                    <!-- View 4: Schedule DataGrid -->
                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Quick Filter Header -->
                            <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" Padding="6,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ScheduleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="26" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextMainBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" VerticalContentAlignment="Center" Padding="4,0" FontSize="14"
                                             ToolTip="Search by ID, category, or material"/>
                                    <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="All"
                                            Command="{Binding SelectAllFilteredCommand}" Padding="6,1" FontSize="14" Margin="4,0,0,0"/>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredScheduleObjects}"
                                      SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                                      SelectionMode="Extended"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      EnableRowVirtualization="True"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Style="{StaticResource ModernDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="110"/>
                                    <DataGridTextColumn Header="Material" Binding="{Binding MaterialId}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Floating Top Right: 3D Distance Measurement Toolbar -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Content="📏 Measure"
                                Command="{Binding ToggleMeasureCommand}"
                                Padding="8,4" Margin="0,0,6,0" FontSize="14"
                                ToolTip="Toggle 3D Point-to-Point Measurement"/>

                        <ComboBox SelectedValue="{Binding MeasureUnit, Mode=TwoWay}" SelectedValuePath="Tag"
                                  Width="64" Height="26" FontSize="14" Margin="0,0,6,0"
                                  Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextMainBrush}">
                            <ComboBoxItem Content="m" Tag="m"/>
                            <ComboBoxItem Content="mm" Tag="mm"/>
                            <ComboBoxItem Content="cm" Tag="cm"/>
                            <ComboBoxItem Content="inch" Tag="inch"/>
                            <ComboBoxItem Content="ft" Tag="ft"/>
                        </ComboBox>

                        <TextBlock Text="{Binding MeasureResultText}" Foreground="{DynamicResource PrimaryBrush}"
                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Visibility="{Binding HasMeasureResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Content="✕" Command="{Binding ClearMeasureCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}"
                                Cursor="Hand" Padding="4" ToolTip="Clear measurement" FontSize="14"
                                Visibility="{Binding HasMeasureResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Floating Bottom Left: Section Box Controls (Bounds động) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" MinWidth="260">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Str_SectionBoxTitle}" Foreground="{DynamicResource TextMainBrush}"
                                       FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding SectionBox.IsEnabled}" HorizontalAlignment="Right"
                                      Content="{DynamicResource Str_SectionBoxEnable}" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                        <StackPanel IsEnabled="{Binding SectionBox.IsEnabled}">
                            <TextBlock Text="X Range" Foreground="{DynamicResource TextMutedBrush}" FontSize="14"/>
                            <Slider Minimum="{Binding SectionBox.MinX}" Maximum="{Binding SectionBox.MaxX}" Value="{Binding SectionBox.MinX}" Margin="0,2,0,6"/>

                            <TextBlock Text="Y Range" Foreground="{DynamicResource TextMutedBrush}" FontSize="14"/>
                            <Slider Minimum="{Binding SectionBox.MinY}" Maximum="{Binding SectionBox.MaxY}" Value="{Binding SectionBox.MinY}" Margin="0,2,0,6"/>

                            <TextBlock Text="Z Range (Cut Height)" Foreground="{DynamicResource TextMutedBrush}" FontSize="14"/>
                            <Slider Minimum="{Binding SectionBox.MinZ}" Maximum="{Binding SectionBox.MaxZ}" Value="{Binding SectionBox.MinZ}" Margin="0,2,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT SIDEBAR: PROPERTIES & COLOR OVERRIDE & GROUPS -->
            <Border Grid.Column="2" Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Property Header -->
                    <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" Padding="12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_PropsTitle}" Foreground="{DynamicResource TextMainBrush}"
                                       FontWeight="Bold" FontSize="20"/>
                            <TextBlock Text="{Binding SelectedObjects.Count, StringFormat='{}{0} Elements Selected'}" 
                                       Foreground="{DynamicResource PrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Color Override & Group Action Toolbar -->
                    <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" Padding="10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Color Override" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Red" Command="{Binding SetColorOverrideCommand}" CommandParameter="#EF4444"
                                        Background="#EF4444" Foreground="White" BorderThickness="0" Margin="2,0" Padding="6,2" Cursor="Hand"/>
                                <Button Content="Orange" Command="{Binding SetColorOverrideCommand}" CommandParameter="#F97316"
                                        Background="#F97316" Foreground="White" BorderThickness="0" Margin="2,0" Padding="6,2" Cursor="Hand"/>
                                <Button Content="Green" Command="{Binding SetColorOverrideCommand}" CommandParameter="#22C55E"
                                        Background="#22C55E" Foreground="White" BorderThickness="0" Margin="2,0" Padding="6,2" Cursor="Hand"/>
                                <Button Content="Blue" Command="{Binding SetColorOverrideCommand}" CommandParameter="#3B82F6"
                                        Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="2,0" Padding="6,2" Cursor="Hand"/>
                                <Button Content="Reset" Command="{Binding ResetColorOverrideCommand}"
                                        Style="{StaticResource ModernButtonStyle}" Margin="4,0" Padding="6,2"/>
                            </StackPanel>

                            <TextBlock Text="Element Opacity" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding SelectedElementsOpacity, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Reset" Command="{Binding ResetElementOpacityCommand}"
                                        Style="{StaticResource ModernButtonStyle}" Margin="6,0,0,0" Padding="6,2"/>
                            </Grid>

                            <TextBlock Text="Create Group" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtGroupName" Text="New Group" Height="26" FontSize="14" Background="{DynamicResource BgSurfaceBrush}"
                                         Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderBrush}" VerticalContentAlignment="Center" Padding="4,0"/>
                                <Button Grid.Column="1" Content="+ Group" Margin="4,0,0,0" Padding="8,2"
                                        Command="{Binding CreateGroupCommand}" CommandParameter="{Binding Text, ElementName=txtGroupName}"
                                        Style="{StaticResource PrimaryAccentButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2-Column DataGrid: Name & Value (VỚI GIÁ TRỊ "varies") -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding PropertiesList}"
                              Style="{StaticResource ModernDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_ColName}" Binding="{Binding Name}" Width="45*"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColValue}" Binding="{Binding Value}" Width="55*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- SETTINGS MODAL DIALOG -->
        <Border Grid.RowSpan="2" Background="#80000000"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="⚙ Settings" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" FontSize="24" VerticalAlignment="Center"/>
                        <Button Content="✕" Command="{Binding ToggleSettingsCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="14" HorizontalAlignment="Right" Cursor="Hand" Padding="4"/>
                    </Grid>

                    <TextBlock Text="Selection Highlight Color" Foreground="{DynamicResource TextMainBrush}" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,6"/>
                    <TextBlock Text="Choose the highlight color for selected BIM elements across all views." 
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Color Palette Chips -->
                    <WrapPanel Margin="0,0,0,14">
                        <Button Width="32" Height="32" Margin="3" Background="#E11D48" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SetSelectionHighlightColorCommand}" CommandParameter="#E11D48" ToolTip="Crimson Red"/>
                        <Button Width="32" Height="32" Margin="3" Background="#3B82F6" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SetSelectionHighlightColorCommand}" CommandParameter="#3B82F6" ToolTip="Blue"/>
                        <Button Width="32" Height="32" Margin="3" Background="#10B981" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SetSelectionHighlightColorCommand}" CommandParameter="#10B981" ToolTip="Green"/>
                        <Button Width="32" Height="32" Margin="3" Background="#F59E0B" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SetSelectionHighlightColorCommand}" CommandParameter="#F59E0B" ToolTip="Amber"/>
                        <Button Width="32" Height="32" Margin="3" Background="#8B5CF6" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SetSelectionHighlightColorCommand}" CommandParameter="#8B5CF6" ToolTip="Purple"/>
                        <Button Width="32" Height="32" Margin="3" Background="#06B6D4" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SetSelectionHighlightColorCommand}" CommandParameter="#06B6D4" ToolTip="Cyan"/>
                        <Button Width="32" Height="32" Margin="3" Background="#EAB308" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SetSelectionHighlightColorCommand}" CommandParameter="#EAB308" ToolTip="Yellow"/>
                    </WrapPanel>

                    <!-- Custom Hex Input -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4" Margin="0,0,8,0"
                                Background="{Binding SelectionHighlightColor}"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectionHighlightColor, UpdateSourceTrigger=PropertyChanged}"
                                 Height="26" FontSize="14" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextMainBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" VerticalContentAlignment="Center" Padding="6,0"/>
                        <Button Grid.Column="2" Content="Apply" Margin="6,0,0,0" Padding="12,0" Height="26"
                                Command="{Binding SetSelectionHighlightColorCommand}" CommandParameter="{Binding SelectionHighlightColor}"
                                Style="{StaticResource PrimaryAccentButtonStyle}"/>
                    </Grid>

                    <Button Content="Close" Command="{Binding ToggleSettingsCommand}"
                            Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Right" Padding="16,6"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- LOADING OVERLAY -->
        <Border Grid.RowSpan="2" Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="8" Margin="0,0,0,14" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding LoadingMessage}" Foreground="{DynamicResource TextMainBrush}" FontWeight="SemiBold"
                               FontSize="20" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
