<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Str_AppTitle">3D高性能モデルビューア (WPF)</system:String>
    <system:String x:Key="Str_OpenFile">ファイル選択...</system:String>
    <system:String x:Key="Str_LoadedFilesTitle">読み込み済みモデルファイル</system:String>
    <system:String x:Key="Str_NoFilesLoaded">ファイルが読み込まれていません。「ファイル選択」をクリックしてください。</system:String>
    <system:String x:Key="Str_ObjectsListTitle">シーン要素一覧</system:String>
    <system:String x:Key="Str_View3D">3Dパース</system:String>
    <system:String x:Key="Str_ViewTop">平面図 (上面)</system:String>
    <system:String x:Key="Str_ViewSection">断面図 (切断)</system:String>
    <system:String x:Key="Str_PropsTitle">要素プロパティ</system:String>
    <system:String x:Key="Str_PropsNoSelection">要素が選択されていません。クリックして選択してください。</system:String>
    <system:String x:Key="Str_ColName">プロパティ名</system:String>
    <system:String x:Key="Str_ColValue">値</system:String>
    <system:String x:Key="Str_SectionBoxTitle">セクションボックス (6面切断)</system:String>
    <system:String x:Key="Str_SectionBoxEnable">断面を有効化</system:String>
    <system:String x:Key="Str_ObjectsCount">ロード済みオブジェクト数:</system:String>

    <!-- Context Menu Strings -->
    <system:String x:Key="Str_MenuIsolate">要素を分離表示 (これのみ表示)</system:String>
    <system:String x:Key="Str_MenuHide">要素を非表示</system:String>
    <system:String x:Key="Str_MenuReset">表示をリセット (すべて再表示)</system:String>
    <system:String x:Key="Str_MenuZoom">全体をズーム</system:String>
</ResourceDictionary>
