<Application x:Class="NMKBim.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NMKBim.Desktop.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <ResourceDictionary.MergedDictionaries>
                <!-- Fonts -->
                <ResourceDictionary Source="Themes/Fonts.xaml"/>
                
                <!-- Active Theme (Default: Dark) -->
                <ResourceDictionary Source="Themes/Theme.Dark.xaml"/>
                
                <!-- Localization (Default: English) -->
                <ResourceDictionary Source="Localization/Strings.en.xaml"/>
                
                <!-- Control Styles -->
                <ResourceDictionary Source="Styles/ButtonStyle.xaml"/>
                <ResourceDictionary Source="Styles/DataGridStyle.xaml"/>
                <ResourceDictionary Source="Styles/CheckBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
