<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Palette Tokens -->
    <Color x:Key="BgBaseColor">#F1F5F9</Color>
    <Color x:Key="BgSurfaceColor">#FFFFFF</Color>
    <Color x:Key="BgCardColor">#F8FAFC</Color>
    <Color x:Key="BgHoverColor">#E2E8F0</Color>
    <Color x:Key="BorderColor">#CBD5E1</Color>
    <Color x:Key="BorderSubtleColor">#E2E8F0</Color>
    <Color x:Key="TextMainColor">#0F172A</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="PrimaryColor">#059669</Color>
    <Color x:Key="HighlightColor">#E11D48</Color>
    <Color x:Key="ViewportBgColor">#E2E8F0</Color>

    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBaseColor}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMainColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}"/>
    <SolidColorBrush x:Key="ViewportBgBrush" Color="{StaticResource ViewportBgColor}"/>
</ResourceDictionary>
